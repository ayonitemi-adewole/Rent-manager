# Copy to .env.local and fill in. Never commit .env.local.
# From Supabase dashboard → Project Settings → API.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=

# Flutterwave TEST public key (Dashboard → Settings → API keys, test mode).
# Secret key + webhook hash go in Supabase edge function secrets, NOT here.
VITE_FLW_PUBLIC_KEY=FLWPUBK_TEST-

# RentPadi's WhatsApp Business number (E.164, e.g. +15551234567 for Meta's test number).
# Shows tenants a "Check rent and receipts on WhatsApp" button. Leave empty until WhatsApp is set up.
VITE_WHATSAPP_NUMBER=

# Public address of the app (no trailing slash). Used for link-preview images when RentPadi links
# are shared on WhatsApp. Set it in Vercel too.
VITE_APP_URL=https://rent-padi.vercel.app

# Support mailbox shown on the Terms and Privacy pages. Leave empty for the default (rentpadiii@gmail.com).
# Keep it the same as the website's SUPPORT_EMAIL. Set it in Vercel too.
VITE_SUPPORT_EMAIL=
